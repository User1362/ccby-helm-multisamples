// CM Hard (Style) — multisample render of a CC BY 4.0 Helm patch (Harsh), author: Mikolis. See SOURCES.md.
<global>
ampeg_release=0.25
loop_mode=no_loop

<region>
sample=CM_Hard_Style__36.flac
lokey=0 hikey=42 pitch_keycenter=36
volume=0.9

<region>
sample=CM_Hard_Style__48.flac
lokey=43 hikey=54 pitch_keycenter=48
volume=-0.0

<region>
sample=CM_Hard_Style__60.flac
lokey=55 hikey=66 pitch_keycenter=60
volume=0.9

<region>
sample=CM_Hard_Style__72.flac
lokey=67 hikey=78 pitch_keycenter=72
volume=-0.4

<region>
sample=CM_Hard_Style__84.flac
lokey=79 hikey=127 pitch_keycenter=84
volume=-1.6
