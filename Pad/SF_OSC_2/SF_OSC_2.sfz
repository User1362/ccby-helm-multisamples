// SF OSC 2 — multisample render of a CC BY 4.0 Helm patch (Pad), author: SF. See SOURCES.md.
<global>
ampeg_release=0.25
loop_mode=no_loop

<region>
sample=SF_OSC_2__36.flac
lokey=0 hikey=42 pitch_keycenter=36
volume=-4.0

<region>
sample=SF_OSC_2__48.flac
lokey=43 hikey=54 pitch_keycenter=48
volume=-1.4

<region>
sample=SF_OSC_2__60.flac
lokey=55 hikey=66 pitch_keycenter=60
volume=-1.3

<region>
sample=SF_OSC_2__72.flac
lokey=67 hikey=78 pitch_keycenter=72
volume=-2.5

<region>
sample=SF_OSC_2__84.flac
lokey=79 hikey=127 pitch_keycenter=84
volume=-1.1
